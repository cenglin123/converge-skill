  "id": "bootstrap-calibration-r2",
  "scope": "cited-history-bootstrap",
  "freshness": {"repository_head": "85b9c2865704c2e0f745ba63766b1bde7ff09bb6", "source_archive_revision": "r1", "source_event_high_watermark": 17},

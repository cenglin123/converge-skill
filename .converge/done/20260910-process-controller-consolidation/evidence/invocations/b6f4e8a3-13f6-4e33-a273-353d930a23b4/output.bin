    {"ref": "git:aac95bd05576e2de5cd2705ba216fae90c7ba8f4", "quantitative_status": "unavailable", "reason": "legacy_aggregate_only"},
    {"ref": "git:0137fceb6dda934394fc101dfc7216785a599c13", "quantitative_status": "unavailable", "reason": "legacy_unbound_run_counts"},

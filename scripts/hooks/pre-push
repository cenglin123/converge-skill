#!/bin/sh
echo "[pre-push] checking for stale active/ items..."
python_exe="${PYTHON:-python}"
top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$top" ] || exit 0
"$python_exe" "$top/scripts/hooks/stale-check.py"
stale_rc=$?
[ "$stale_rc" -eq 0 ] || exit "$stale_rc"

# --allow-legacy: 只放行「压根没有 manifest 可校验」的 pre-contract 归档（会打印出来），
# 契约违反照旧阻断。豁免声明在调用点，不在检查器里——检查器默认仍 fail-closed。
echo "[pre-push] checking changed Archive Contract v1 done directories..."
received=0
while read -r local_ref local_sha remote_ref remote_sha; do
  received=1
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  case "$remote_sha" in
    0000000000000000000000000000000000000000)
      "$python_exe" "$top/scripts/archive_convergence.py" check-push-range "$top" "$remote_sha" "$local_sha" --allow-legacy || exit $? ;;
    *) "$python_exe" "$top/scripts/archive_convergence.py" check-push-range "$top" "$remote_sha" "$local_sha" --allow-legacy || exit $? ;;
  esac
done

# Direct/manual hook invocation has no pre-push stdin; inspect the latest commit.
if [ "$received" -eq 0 ]; then
  zero=0000000000000000000000000000000000000000
  "$python_exe" "$top/scripts/archive_convergence.py" check-push-range "$top" "$zero" HEAD --allow-legacy || exit $?
fi
